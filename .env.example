# MeshKor Lien Valuation backend: settings.
# Copy this file to .env (same folder) and fill in the values:   copy .env.example .env
# .env holds secrets: it is in .gitignore. NEVER commit .env, and never paste it into a chat or email.
# A real environment variable wins over the same line in .env.

# ---------------------------------------------------------------- database (PostgreSQL)
POSTGRES_DB=meshkor
POSTGRES_USER=meshkor
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
# PostgreSQL's port: see "port =" in C:\Program Files\PostgreSQL\<version>\data\postgresql.conf
POSTGRES_PORT=5432
# Do not set DB_ENGINE here. Set it only in the window where you run the tests:  $env:DB_ENGINE="sqlite"
# DB_ENGINE=postgresql

# ---------------------------------------------------------------- Django
# 50+ random characters; signs the sign-in tokens. Make one:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 on a developer PC only; 0 (or remove) on a server
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 1 on a server behind HTTPS: secure cookies, HSTS, HTTPS redirect; refuses to start without DJANGO_SECRET_KEY
DJANGO_SECURE=0

# ---------------------------------------------------------------- bills and EOBs (PHI)
# Fernet key that encrypts every stored bill. Make it ONCE and BACK IT UP: without it the bills cannot be opened.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESHKOR_FILE_KEY=
# Where the encrypted bills are stored. Default: <MESHKOR_DATA_ROOT>\uploads. On a server: encrypted storage, backed up.
# MESHKOR_UPLOAD_DIR=D:\Meshkor\uploads
# Who prices a new upload. thread (default): the web server, in the background; nothing else to run.
# worker: the web server only queues; also run  python backend\manage.py pricing_worker  (live server).
# MESHKOR_PRICING=thread
# How many bills are priced at the same time (OCR uses a lot of CPU)
# MESHKOR_PRICING_THREADS=2
# 1 = a different reviewer must approve a case whose flags you resolved
MESHKOR_FOUR_EYES=0

# ---------------------------------------------------------------- reference data (CMS files, price files)
# Parquet, DuckDB and reports. Default: <repo>\data
# MESHKOR_DATA_ROOT=D:\Meshkor\meshkor-data\data
# Folder with the raw CMS downloads and hospital price files (only needed to load or reload data)
# MESHKOR_RAW_DIR=E:\Datasetof CMS
# sources_local.yaml on the build PC (lists the releases in MESHKOR_RAW_DIR); leave unset for the tests
# MESHKOR_SOURCES=sources_local.yaml
# MESHKOR_CONFIG_DIR=D:\Meshkor\meshkor-data\config

# ---------------------------------------------------------------- website
# The website's address(es): allowed to call the API, and used in the "report ready" e-mail
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MESHKOR_PORTAL_URL=http://localhost:5173
# How long a sign-in lasts
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

# ---------------------------------------------------------------- e-mail ("report ready")
# The console backend prints the e-mail in the server window. For real mail, use SMTP and fill the lines below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=reports@meshkor.com
